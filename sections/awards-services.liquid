{% comment %}
  Awards + services - the sxlvx.de scroll sequence.

    1. "AWARDED 8 TIMES." pins on a dark screen: a wireframe globe with a ring
       of award names spinning round its equator in 3D. Scrolling zooms the
       camera into the globe, the words fade, and a cream circle grows out of
       the middle until it fills the screen.
    2. On the cream, a huge heading with a tilted sticker, then service rows
       that stick and stack over each other as you scroll. Each row has a
       coloured card with its own little animation: a design-tool selection,
       a browser typing, a camera viewfinder, sticky notes.

  GSAP ScrollTrigger over the real document scroll, so it runs under the
  Smooth scroll section unchanged. The stacking rows are plain CSS sticky.
  Without JavaScript, or with reduced motion, everything shows still.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign sid = section.id | replace: '_', '-'
  assign ring_lines = s.ring_items | newline_to_br | split: '<br />'
  assign award_lines = s.award_note | newline_to_br | split: '<br />'
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter+Tight:wght@500;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

<section class="aws" id="aws-{{ sid }}" data-aws data-pin="{{ s.zoom_length }}"
  style="--aws-dark:{{ s.dark_color }};--aws-light:{{ s.light_color }};--aws-cream:{{ s.cream_color }};--aws-ink:{{ s.ink_color }};--aws-gold:{{ s.gold_color }};--aws-pin:{{ s.zoom_length }}vh;--aws-sticker:{{ s.sticker_color }};--aws-line:{{ s.line_color }};--aws-line-o:{{ s.line_strength | divided_by: 100.0 }};">

  {%- comment -%} 1. the globe {%- endcomment -%}
  <div class="aws__zoom" data-aws-zoom>
    <div class="aws__stage">
      <div class="aws__top" data-aws-top>
        <h2 class="aws__awarded">{{ s.awards_heading | escape }}</h2>
        <p class="aws__note">
          {%- for line in award_lines -%}{{ line | strip | escape }}{% unless forloop.last %}<br>{% endunless %}{%- endfor -%}
        </p>
      </div>

      <div class="aws__world" data-aws-world>
        <svg class="aws__globe" viewBox="-100 -100 200 200" aria-hidden="true" focusable="false">
          <circle r="96"/>
          {%- for lat in (1..5) -%}
            {%- liquid
              assign deg = lat | times: 25 | minus: 75
              assign rad = deg | times: 3.14159 | divided_by: 180.0
            -%}
            <ellipse class="aws__lat" data-lat="{{ deg }}" cx="0" cy="0" rx="96" ry="14"/>
          {%- endfor -%}
          {%- for lon in (1..6) -%}
            <ellipse class="aws__lon" data-lon="{{ lon | times: 30 }}" cx="0" cy="0" rx="96" ry="96"/>
          {%- endfor -%}
        </svg>

        <div class="aws__ring" data-aws-ring aria-hidden="true">
          {%- for line in ring_lines -%}
            {%- assign t = line | strip -%}
            {%- if t != blank -%}
              <span class="aws__item{% cycle '', ' aws__item--small' %}" data-aws-item>{{ t | escape }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="aws__iris" data-aws-iris></div>
    </div>
  </div>

  {%- comment -%} 2. what we make {%- endcomment -%}
  <div class="aws__make">
    <div class="aws__head">
      <h2 class="aws__title" data-aws-title>
        {{ s.services_heading | escape }}
        {%- if s.sticker_text != blank -%}
          <span class="aws__sticker" data-aws-sticker style="left:{{ s.sticker_x }}%;">{{ s.sticker_text | escape }}</span>
        {%- endif -%}
      </h2>
    </div>

    <div class="aws__rows">
      {%- for b in section.blocks -%}
        {%- assign i = b.settings -%}
        {%- assign lines = i.card_text | newline_to_br | split: '<br />' -%}
        {%- assign services = i.services | split: ',' -%}
        <article class="aws__row" data-aws-row style="z-index:{{ forloop.index }};" {{ b.shopify_attributes }}>
          <div class="aws__copy">
            <h3 class="aws__name">{{ i.title | escape }}</h3>
            {%- if services.size > 0 -%}
              <p class="aws__label">{{ s.services_label | escape }}</p>
              <ul class="aws__pills" role="list">
                {%- for sv in services -%}{%- assign t = sv | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="aws__tags">
              {%- if i.tag1_label != blank -%}<a class="aws__tag" href="{{ i.tag1_link | default: '#' }}" style="background:{{ i.tag1_color }};">{{ i.tag1_label | escape }} &rarr;</a>{%- endif -%}
              {%- if i.tag2_label != blank -%}<a class="aws__tag" href="{{ i.tag2_link | default: '#' }}" style="background:{{ i.tag2_color }};{% if i.tag2_dark %}color:#fff;{% endif %}">{{ i.tag2_label | escape }} &rarr;</a>{%- endif -%}
            </div>
          </div>

          <div class="aws__card aws__card--{{ i.card }}" data-aws-card="{{ i.card }}" style="background:{{ i.card_color }};">
            {%- case i.card -%}
              {%- when 'branding' -%}
                <svg class="aws__brand" viewBox="0 0 220 150" aria-hidden="true" focusable="false">
                  <rect class="aws__guide" x="44" y="26" width="132" height="98"/>
                  <line class="aws__guide" x1="30" y1="75" x2="190" y2="75"/>
                  <circle class="aws__guide" cx="92" cy="75" r="40"/>
                  <circle class="aws__guide" cx="128" cy="75" r="40"/>
                  <path class="aws__half-dark" d="M54,75 A38,38 0 0 1 130,75 Z"/>
                  <g class="aws__half-light">
                    <path d="M90,75 A38,38 0 0 0 166,75 Z"/>
                    <g class="aws__handles">
                      <rect x="87" y="72" width="6" height="6"/><rect x="163" y="72" width="6" height="6"/>
                      <rect x="125" y="110" width="6" height="6"/><rect x="125" y="72" width="6" height="6"/>
                    </g>
                  </g>
                  <g class="aws__cursor">
                    <path d="M0,0 L0,13 L3.5,10 L6,15.5 L8,14.5 L5.6,9.2 L10,9.2 Z"/>
                    <rect x="8" y="14" width="24" height="9" rx="2"/>
                    <text x="20" y="20.6">{{ lines[0] | default: 'YOU' | strip | escape }}</text>
                  </g>
                </svg>

              {%- when 'web' -%}
                <div class="aws__browser">
                  <div class="aws__bar"><i></i><i></i><i></i><span>{{ lines[1] | default: 'yourbrand.com/your-page' | strip | escape }}</span></div>
                  <div class="aws__page">
                    <p class="aws__brandname">{{ lines[2] | default: 'YOUR BRAND' | strip | escape }}<span></span></p>
                    <p class="aws__typed"><span data-aws-type="{{ lines[0] | default: 'BE FOUND.' | strip | escape }}"></span><b class="aws__caret"></b></p>
                  </div>
                </div>

              {%- when 'video' -%}
                <div class="aws__finder">
                  <span class="aws__corner aws__corner--tl"></span><span class="aws__corner aws__corner--tr"></span>
                  <span class="aws__corner aws__corner--bl"></span><span class="aws__corner aws__corner--br"></span>
                  <p class="aws__rec"><i></i>REC</p>
                  <p class="aws__tc" data-aws-tc>00:00:00:00</p>
                  <span class="aws__focus"></span>
                  <span class="aws__cross"></span>
                  <p class="aws__flabel">{{ lines[0] | default: 'I FILMED MYSELF.' | strip | escape }}</p>
                  <div class="aws__timeline">
                    <span style="--w:22%;--c:#f59ad0"></span><span style="--w:30%;--c:#ff7f50"></span><span style="--w:16%;--c:#c9a0f7"></span><span style="--w:20%;--c:#f59ad0"></span>
                    <span style="--w:34%;--c:#dff04a"></span><span style="--w:24%;--c:#9aa63c"></span>
                    <i class="aws__head-line"></i>
                  </div>
                </div>

              {%- when 'strategy' -%}
                <div class="aws__board">
                  {%- assign colours = '#ffffff,#f59ad0,#ff7f50,#c9a0f7' | split: ',' -%}
                  {%- assign tilts = '-4,5,-3,6' | split: ',' -%}
                  {%- for n in (0..3) -%}
                    <div class="aws__note-card aws__note-card--{{ n | plus: 1 }}" style="background:{{ colours[n] }};--r:{{ tilts[n] }}deg;--d:{{ n | times: 0.25 }}s;">
                      <small>WORKSHOP · 0{{ n | plus: 1 }}</small>
                      <span>{{ lines[n] | default: 'Question?' | strip | escape }}</span>
                    </div>
                  {%- endfor -%}
                  <div class="aws__result"><small>Result</small><span>{{ lines[4] | default: 'CLEAR POSITION.' | strip | escape }}</span></div>
                  <p class="aws__foot">{{ lines[5] | default: 'QUESTIONS FIRST. THEN CONSTRUCTION.' | strip | escape }}</p>
                </div>
            {%- endcase -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #aws-{{ sid }} { position: relative; background: var(--aws-cream); color: var(--aws-ink); overflow: clip; }
  #aws-{{ sid }} * { box-sizing: border-box; }

  /* ---------- 1. globe ---------- */
  #aws-{{ sid }} .aws__zoom { position: relative; background: var(--aws-dark); color: var(--aws-light); }
  #aws-{{ sid }} .aws__stage { position: relative; height: 100vh; overflow: hidden; }

  #aws-{{ sid }} .aws__top { position: absolute; left: 5vw; right: 5vw; top: 8vh; display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; z-index: 3; }
  #aws-{{ sid }} .aws__awarded { margin: 0; color: inherit; font-family: 'Bebas Neue', var(--font-heading-family, sans-serif); font-weight: 400; font-size: clamp(2.4rem, 4.6vw, 5rem); line-height: .9; letter-spacing: .005em; }
  #aws-{{ sid }} .aws__note { margin: .4rem 0 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: clamp(.55rem, .75vw, .75rem); letter-spacing: .08em; line-height: 1.7; opacity: .6; text-transform: uppercase; }

  #aws-{{ sid }} .aws__world {
    --g: min(74vh, 58vw);
    position: absolute; left: 50%; top: 56%; width: var(--g); height: var(--g);
    margin: calc(var(--g) / -2) 0 0 calc(var(--g) / -2); z-index: 1;
    perspective: 1400px; will-change: transform, opacity;
  }
  #aws-{{ sid }} .aws__globe { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  #aws-{{ sid }} .aws__globe circle, #aws-{{ sid }} .aws__globe ellipse { fill: none; stroke: var(--aws-line); stroke-opacity: var(--aws-line-o); stroke-width: 1.2; vector-effect: non-scaling-stroke; }

  #aws-{{ sid }} .aws__ring { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; }
  #aws-{{ sid }} .aws__item { display: none; }
  #aws-{{ sid }} .aws__ch {
    position: absolute; left: 0; top: 0; white-space: pre;
    font-family: 'Inter Tight', var(--font-body-family, sans-serif); font-weight: 700; line-height: 1;
    font-size: calc(var(--g) * .06 * var(--k, 1)); letter-spacing: -.02em; color: var(--aws-light);
    transform-origin: 50% 50%; backface-visibility: visible; will-change: transform, opacity;
  }
  #aws-{{ sid }} .aws__ch--small { font-weight: 500; font-size: calc(var(--g) * .024 * var(--k, 1)); letter-spacing: .04em; color: var(--aws-gold); text-transform: uppercase; }
  #aws-{{ sid }} .aws__ch--dot { color: var(--aws-gold); font-size: calc(var(--g) * .024 * var(--k, 1)); }

  #aws-{{ sid }} .aws__iris { position: absolute; inset: 0; z-index: 4; background: var(--aws-cream); clip-path: circle(0% at 50% 50%); pointer-events: none; }

  /* without the script: a plain static ring under the globe */
  #aws-{{ sid }}:not([data-aws-live]) .aws__ring { display: flex; flex-wrap: wrap; justify-content: center; gap: .6em; width: 120%; left: -10%; top: 56%; height: auto; }
  #aws-{{ sid }}:not([data-aws-live]) .aws__item { display: inline; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: calc(var(--g) * .05); }
  #aws-{{ sid }}:not([data-aws-live]) .aws__item--small { font-size: calc(var(--g) * .022); color: var(--aws-gold); text-transform: uppercase; align-self: center; }

  /* ---------- 2. services ---------- */
  #aws-{{ sid }} .aws__make { position: relative; padding: 0 5vw 20vh; background: var(--aws-cream); }
  #aws-{{ sid }} .aws__head { padding: 26vh 0 10vh; }
  #aws-{{ sid }} .aws__title {
    position: relative; display: inline-block; margin: 0; color: var(--aws-ink);
    font-family: 'Bebas Neue', var(--font-heading-family, sans-serif); font-weight: 400;
    font-size: clamp(3.6rem, 10.5vw, 12rem); line-height: .86; letter-spacing: -.005em;
  }
  #aws-{{ sid }} .aws__sticker {
    position: absolute; top: 34%; padding: .28em .55em .2em; border-radius: .25em;
    background: var(--aws-sticker); color: var(--aws-ink);
    font-family: 'Bebas Neue', sans-serif; font-size: .2em; line-height: 1; letter-spacing: .02em; white-space: nowrap;
    transform: rotate(-14deg); box-shadow: 0 .05em .12em rgba(0,0,0,.15);
  }

  #aws-{{ sid }} .aws__rows { position: relative; }
  #aws-{{ sid }}[data-aws-live] .aws__row { position: relative; top: auto; }
  #aws-{{ sid }} .aws__row {
    position: sticky; top: 10vh;
    display: grid; grid-template-columns: 1fr; gap: 1.6rem;
    padding: 3.2rem 0 3.6rem; background: var(--aws-cream);
    border-top: 1px solid color-mix(in srgb, var(--aws-ink) 45%, transparent);
    min-height: 62vh;
  }
  #aws-{{ sid }} .aws__name { margin: 0 0 1.6rem; color: var(--aws-ink); font-family: 'Bebas Neue', sans-serif; font-weight: 400; font-size: clamp(2.4rem, 4.4vw, 4.6rem); line-height: .9; }
  #aws-{{ sid }} .aws__label { margin: 0 0 .9rem; font-family: 'Inter Tight', sans-serif; font-weight: 700; font-size: .8rem; letter-spacing: .02em; }
  #aws-{{ sid }} .aws__pills { display: flex; flex-wrap: wrap; gap: .45rem; max-width: 34rem; margin: 0 0 1.3rem; padding: 0; list-style: none; }
  #aws-{{ sid }} .aws__pills li { padding: .5em 1em; border-radius: 999px; background: #fff; border: 1px solid color-mix(in srgb, var(--aws-ink) 12%, transparent); font-family: 'Inter Tight', sans-serif; font-weight: 500; font-size: .66rem; letter-spacing: .02em; text-transform: uppercase; }
  #aws-{{ sid }} .aws__tags { display: flex; flex-wrap: wrap; gap: .6rem; }
  #aws-{{ sid }} .aws__tag { padding: .45em .8em; color: var(--aws-ink); text-decoration: none; font-family: 'JetBrains Mono', monospace; font-size: .62rem; letter-spacing: .06em; text-transform: uppercase; transform: rotate(-1deg); }
  #aws-{{ sid }} .aws__tag:hover { filter: brightness(.94); }

  #aws-{{ sid }} .aws__card { position: relative; width: 100%; aspect-ratio: 1.36; border-radius: 1.6rem; overflow: hidden; }
  @media (min-width: 750px) {
    #aws-{{ sid }} .aws__row { grid-template-columns: 1fr 41%; align-items: start; gap: 4vw; }
  }

  /* branding: a selection in a design tool */
  #aws-{{ sid }} .aws__brand { position: absolute; inset: 8% 10%; width: 80%; height: 84%; overflow: visible; }
  #aws-{{ sid }} .aws__guide { fill: none; stroke: #2a1c14; stroke-opacity: .55; stroke-width: .7; }
  #aws-{{ sid }} .aws__half-dark { fill: #121212; }
  #aws-{{ sid }} .aws__half-light path { fill: #fff; }
  #aws-{{ sid }} .aws__half-light { transform-box: view-box; transform-origin: 128px 75px; transform: rotate(-180deg) translate(0, 0); transition: transform 1.1s cubic-bezier(.7,0,.2,1) .25s; }
  #aws-{{ sid }} .aws__handles rect { fill: #fff; stroke: #2a1c14; stroke-width: .7; opacity: 0; transition: opacity .3s ease 1.3s; }
  #aws-{{ sid }} .aws__cursor { transform: translate(178px, 128px); transition: transform 1.1s cubic-bezier(.7,0,.2,1) .25s; }
  #aws-{{ sid }} .aws__cursor path { fill: #111; stroke: #fff; stroke-width: .8; }
  #aws-{{ sid }} .aws__cursor rect { fill: #dff04a; }
  #aws-{{ sid }} .aws__cursor text { font: 600 5px 'JetBrains Mono', monospace; text-anchor: middle; fill: #111; }
  #aws-{{ sid }} .is-in .aws__half-light { transform: rotate(0deg); }
  #aws-{{ sid }} .is-in .aws__handles rect { opacity: 1; }
  #aws-{{ sid }} .is-in .aws__cursor { transform: translate(150px, 90px); }

  /* web: a browser that types */
  #aws-{{ sid }} .aws__browser { position: absolute; left: 9%; right: 9%; top: 9%; bottom: 13%; background: #fff; border: 2px solid #111; border-radius: .7rem; box-shadow: .45rem .45rem 0 #111; overflow: hidden; }
  #aws-{{ sid }} .aws__bar { display: flex; align-items: center; gap: .3rem; padding: .45rem .6rem; border-bottom: 2px solid #111; }
  #aws-{{ sid }} .aws__bar i { width: .45rem; height: .45rem; border: 1.5px solid #111; border-radius: 50%; }
  #aws-{{ sid }} .aws__bar span { margin-left: .4rem; padding: .05rem .6rem; border: 1.5px solid #111; border-radius: 999px; font: .5rem 'JetBrains Mono', monospace; flex: 1; max-width: 60%; }
  #aws-{{ sid }} .aws__page { padding: .9rem 1.1rem; }
  #aws-{{ sid }} .aws__brandname { display: flex; justify-content: space-between; margin: 0 0 1rem; font: 600 .55rem 'Inter Tight', sans-serif; letter-spacing: .02em; }
  #aws-{{ sid }} .aws__brandname span { width: 30%; height: 2px; margin-top: .3rem; background: repeating-linear-gradient(90deg, #bbb 0 18%, transparent 18% 34%); }
  #aws-{{ sid }} .aws__typed { margin: 0; font-family: 'Bebas Neue', sans-serif; font-size: clamp(1.4rem, 2.6vw, 2.8rem); line-height: 1; color: #111; }
  #aws-{{ sid }} .aws__caret { display: inline-block; width: 2px; height: .8em; margin-left: .06em; background: #111; vertical-align: -.05em; animation: aws-blink-{{ sid }} 1s steps(1) infinite; }

  /* video: a camera viewfinder */
  #aws-{{ sid }} .aws__finder { position: absolute; inset: 7%; color: #f3ece2; font-family: 'JetBrains Mono', monospace; }
  #aws-{{ sid }} .aws__corner { position: absolute; width: 1.1rem; height: 1.1rem; border: 0 solid #f3ece2; }
  #aws-{{ sid }} .aws__corner--tl { left: 0; top: 0; border-width: 2px 0 0 2px; }
  #aws-{{ sid }} .aws__corner--tr { right: 0; top: 0; border-width: 2px 2px 0 0; }
  #aws-{{ sid }} .aws__corner--bl { left: 0; bottom: 22%; border-width: 0 0 2px 2px; }
  #aws-{{ sid }} .aws__corner--br { right: 0; bottom: 22%; border-width: 0 2px 2px 0; }
  #aws-{{ sid }} .aws__rec { position: absolute; left: 1.4rem; top: .35rem; margin: 0; font-size: .5rem; letter-spacing: .1em; display: flex; align-items: center; gap: .35rem; }
  #aws-{{ sid }} .aws__rec i { width: .45rem; height: .45rem; border-radius: 50%; background: #ff3b30; animation: aws-blink-{{ sid }} 1.2s steps(1) infinite; }
  #aws-{{ sid }} .aws__tc { position: absolute; right: 1.4rem; top: .35rem; margin: 0; font-size: .5rem; letter-spacing: .08em; }
  #aws-{{ sid }} .aws__focus { position: absolute; left: 50%; top: 36%; width: 14%; aspect-ratio: 1; border: 1.5px solid #dff04a; transform: translate(-50%, -50%); }
  #aws-{{ sid }} .aws__cross { position: absolute; left: 30%; right: 30%; top: 36%; height: 1px; background: rgba(243,236,226,.5); }
  #aws-{{ sid }} .aws__flabel { position: absolute; left: 50%; top: 55%; margin: 0; padding: .15em .45em; background: #f59ad0; color: #111; font-family: 'Bebas Neue', sans-serif; font-size: clamp(1rem, 1.7vw, 1.8rem); line-height: 1.1; white-space: nowrap; transform: translateX(-50%) rotate(-3deg); }
  #aws-{{ sid }} .aws__timeline { position: absolute; left: 0; right: 0; bottom: 0; height: 16%; display: flex; flex-wrap: wrap; align-content: space-between; gap: 6% 1.5%; padding-top: 3%; }
  #aws-{{ sid }} .aws__timeline span { height: 38%; width: var(--w); background: var(--c); border-radius: 2px; }
  #aws-{{ sid }} .aws__head-line { position: absolute; top: 0; bottom: 0; left: 0; width: 2px; background: #ff3b30; animation: aws-play-{{ sid }} 6s linear infinite; animation-play-state: paused; }
  #aws-{{ sid }} .is-in .aws__head-line { animation-play-state: running; }

  /* strategy: sticky notes */
  #aws-{{ sid }} .aws__board { position: absolute; inset: 0; }
  #aws-{{ sid }} .aws__note-card {
    position: absolute; width: 24%; aspect-ratio: 1.05; padding: .55rem .6rem; color: #111;
    box-shadow: 0 .3rem .6rem rgba(0,0,0,.12); transform: rotate(var(--r)) scale(.6); opacity: 0;
    transition: transform .5s cubic-bezier(.3,1.6,.5,1) var(--d), opacity .25s ease var(--d);
  }
  #aws-{{ sid }} .aws__note-card small { display: block; margin-bottom: .35rem; font: .4rem 'JetBrains Mono', monospace; letter-spacing: .06em; opacity: .7; }
  #aws-{{ sid }} .aws__note-card span { display: block; font-family: 'Bebas Neue', sans-serif; font-size: clamp(.8rem, 1.25vw, 1.35rem); line-height: .95; text-transform: uppercase; }
  #aws-{{ sid }} .aws__note-card--1 { left: 7%; top: 9%; }
  #aws-{{ sid }} .aws__note-card--2 { left: 35%; top: 6%; }
  #aws-{{ sid }} .aws__note-card--3 { left: 9%; top: 48%; }
  #aws-{{ sid }} .aws__note-card--4 { left: 38%; top: 46%; }
  #aws-{{ sid }} .aws__result {
    position: absolute; right: 8%; top: 30%; width: 26%; aspect-ratio: 1; border-radius: 50%; background: #111; color: #fff;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
    transform: scale(0) rotate(-20deg); transition: transform .55s cubic-bezier(.3,1.6,.5,1) 1.3s;
  }
  #aws-{{ sid }} .aws__result small { font: .4rem 'JetBrains Mono', monospace; color: #dff04a; margin-bottom: .2rem; }
  #aws-{{ sid }} .aws__result span { font-family: 'Bebas Neue', sans-serif; font-size: clamp(.8rem, 1.4vw, 1.5rem); line-height: .95; padding: 0 .6rem; }
  #aws-{{ sid }} .aws__foot { position: absolute; left: 7%; bottom: 6%; margin: 0; padding: .3em .6em; background: #fff; font: .45rem 'JetBrains Mono', monospace; letter-spacing: .06em; opacity: 0; transition: opacity .4s ease 1.7s; }
  #aws-{{ sid }} .is-in .aws__note-card { transform: rotate(var(--r)) scale(1); opacity: 1; }
  #aws-{{ sid }} .is-in .aws__result { transform: scale(1) rotate(0deg); }
  #aws-{{ sid }} .is-in .aws__foot { opacity: 1; }

  @keyframes aws-blink-{{ sid }} { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  @keyframes aws-play-{{ sid }} { from { left: 0; } to { left: 100%; } }

  @media (prefers-reduced-motion: reduce) {
    #aws-{{ sid }} .aws__card * { transition: none !important; animation: none !important; }
  }
  /* without the script the cards show their finished state */
  #aws-{{ sid }}:not([data-aws-live]) .aws__card .aws__half-light { transform: none; }
  #aws-{{ sid }}:not([data-aws-live]) .aws__card .aws__handles rect,
  #aws-{{ sid }}:not([data-aws-live]) .aws__card .aws__note-card,
  #aws-{{ sid }}:not([data-aws-live]) .aws__card .aws__foot { opacity: 1; transform: rotate(var(--r, 0deg)); }
  #aws-{{ sid }}:not([data-aws-live]) .aws__card .aws__result { transform: none; }
</style>

<script>
  (function () {
    var host = document.getElementById('aws-{{ sid }}');
    if (!host || host.dataset.awsReady) return;
    host.dataset.awsReady = '1';

    var calm = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- cards play their little animation when they come into view ---- */
    var timers = [];
    function typeIn(el) {
      var full = el.getAttribute('data-aws-type') || '';
      var n = 0; el.textContent = '';
      (function step() {
        el.textContent = full.slice(0, n);
        if (n++ < full.length) timers.push(setTimeout(step, 110 + Math.random() * 90));
      })();
    }
    function timecode(el) {
      var start = performance.now();
      (function tick(now) {
        if (!el.isConnected) return;
        var t = (now - start) / 1000, f = Math.floor((t % 1) * 25), sec = Math.floor(t) % 60, min = Math.floor(t / 60) % 60;
        function p(v) { return (v < 10 ? '0' : '') + v; }
        el.textContent = '00:' + p(min) + ':' + p(sec) + ':' + p(f);
        requestAnimationFrame(tick);
      })(start);
    }
    var cards = host.querySelectorAll('[data-aws-card]');
    function show(card) {
      if (card.classList.contains('is-in')) return;
      card.classList.add('is-in');
      var typed = card.querySelector('[data-aws-type]');
      if (typed) { if (calm) typed.textContent = typed.getAttribute('data-aws-type'); else typeIn(typed); }
      var tc = card.querySelector('[data-aws-tc]');
      if (tc && !calm) timecode(tc);
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } });
      }, { threshold: 0.45 });
      cards.forEach(function (c) { io.observe(c); });
    } else {
      cards.forEach(show);
    }
    host.querySelectorAll('[data-aws-type]').forEach(function (el) { el.textContent = ''; });

    if (calm) { cards.forEach(show); return; }

    var CDN = 'https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/';
    function load(src) {
      return new Promise(function (ok, fail) {
        var el = document.querySelector('script[data-nfn-src="' + src + '"]');
        if (el) { if (el.dataset.done) ok(); else el.addEventListener('load', ok); return; }
        el = document.createElement('script');
        el.src = src; el.dataset.nfnSrc = src;
        el.onload = function () { el.dataset.done = '1'; ok(); };
        el.onerror = fail;
        document.head.appendChild(el);
      });
    }

    var made = [], rafId;

    function build() {
      var gsap = window.gsap, ScrollTrigger = window.ScrollTrigger;
      gsap.registerPlugin(ScrollTrigger);

      var zoom = host.querySelector('[data-aws-zoom]');
      var world = host.querySelector('[data-aws-world]');
      var ring = host.querySelector('[data-aws-ring]');
      var top = host.querySelector('[data-aws-top]');
      var iris = host.querySelector('[data-aws-iris]');
      var globe = host.querySelector('.aws__globe');
      var stage = host.querySelector('.aws__stage');

      host.setAttribute('data-aws-live', '');

      /* the globe: latitudes are flattened ellipses, longitudes narrow with the angle */
      var TILT = 0.16;
      globe.querySelectorAll('[data-lat]').forEach(function (e) {
        var a = parseFloat(e.getAttribute('data-lat')) * Math.PI / 180;
        var r = 96 * Math.cos(a);
        e.setAttribute('cy', (-96 * Math.sin(a) * Math.cos(TILT * 2)).toFixed(2));
        e.setAttribute('rx', r.toFixed(2));
        e.setAttribute('ry', (r * TILT * 1.1).toFixed(2));
      });
      var lons = globe.querySelectorAll('[data-lon]');

      /* the ring: every letter sits on a circle round the equator */
      var items = ring.querySelectorAll('[data-aws-item]');
      var chars = [];
      function addChar(c, cls) {
        var sp = document.createElement('span');
        sp.className = 'aws__ch' + (cls ? ' ' + cls : '');
        sp.textContent = c;
        ring.appendChild(sp);
        chars.push({ el: sp, w: 0, a: 0 });
      }
      function fill() {
        items.forEach(function (it) {
          var small = it.classList.contains('aws__item--small');
          (it.textContent || '').split('').forEach(function (c) { addChar(c, small ? 'aws__ch--small' : ''); });
          addChar('  ◆  ', 'aws__ch--dot');
        });
      }
      fill();

      var R = 1;
      function layout() {
        var g = world.clientWidth;
        ring.style.removeProperty('--k');
        R = g * 0.5 * 1.04;
        chars.forEach(function (c) { c.w = c.el.offsetWidth; });
        var total = chars.reduce(function (sum, c) { return sum + c.w; }, 0);
        /* repeat the words until they go most of the way round */
        var circ = Math.PI * 2 * R;
        var guard = 0;
        while (total < circ * 0.82 && guard++ < 6) {
          var n = chars.length; fill();
          for (var k = n; k < chars.length; k++) { chars[k].w = chars[k].el.offsetWidth; total += chars[k].w; }
        }
        /* too many words for one turn: shrink the letters until they fit */
        if (total > circ * 0.94) {
          var k = (parseFloat(ring.style.getPropertyValue('--k')) || 1) * (circ * 0.94) / total;
          ring.style.setProperty('--k', k.toFixed(3));
          total = 0;
          chars.forEach(function (c) { c.w = c.el.offsetWidth; total += c.w; });
        }
        var gap = Math.max(0, (circ - total) / chars.length);
        var arc = 0;
        chars.forEach(function (c) {
          c.a = (arc + c.w / 2) / R;
          arc += c.w + gap;
          c.el.style.marginLeft = (-c.w / 2) + 'px';
          c.el.style.marginTop = (-c.el.offsetHeight / 2) + 'px';
        });
      }
      layout();

      var spin = 0, last = 0, extra = 0;
      function frame(t) {
        if (!host.isConnected) return;
        var dt = last ? Math.min(64, t - last) : 16; last = t;
        spin -= dt * 0.00012;
        var s = spin + extra;
        ring.style.transform = 'translateY(' + (R * 0.2).toFixed(1) + 'px) rotateX(-12deg)';
        for (var i = 0; i < chars.length; i++) {
          var c = chars[i], a = c.a + s, depth = Math.cos(a);
          c.el.style.transform = 'rotateY(' + (a * 180 / Math.PI).toFixed(2) + 'deg) translateZ(' + R.toFixed(1) + 'px)';
          c.el.style.opacity = depth > 0 ? (0.3 + 0.7 * depth).toFixed(3) : (0.06 + 0.16 * -depth).toFixed(3);
        }
        /* longitudes turn slowly with the ring */
        for (var j = 0; j < lons.length; j++) {
          var la = parseFloat(lons[j].getAttribute('data-lon')) * Math.PI / 180 + s;
          lons[j].setAttribute('rx', Math.abs(96 * Math.sin(la)).toFixed(2));
        }
        rafId = requestAnimationFrame(frame);
      }
      rafId = requestAnimationFrame(frame);

      /* the scroll: zoom into the globe, then the cream iris opens */
      var tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: stage, start: 'top top',
          end: function () { return '+=' + window.innerHeight * (parseFloat(host.dataset.pin) || 180) / 100; },
          pin: true, anticipatePin: 1, scrub: 0.6, invalidateOnRefresh: true,
          onUpdate: function (self) { extra = -self.progress * 1.6; }
        }
      });
      tl.to(top, { opacity: 0, y: -40, duration: 0.3 }, 0.12);
      tl.fromTo(world, { scale: 1, y: 0 }, { scale: 3.2, y: function () { return -window.innerHeight * 0.12; }, duration: 0.62, ease: 'power2.in' }, 0);
      tl.to(world, { opacity: 0, duration: 0.12 }, 0.52);
      tl.fromTo(iris, { clipPath: 'circle(0% at 50% 50%)' }, { clipPath: 'circle(75% at 50% 50%)', duration: 0.42, ease: 'power2.in' }, 0.52);
      made.push(tl);

      /* the service rows: each one pins near the top and the next slides up over
         it, until the last row arrives - the stacking cards of the reference */
      var rows = host.querySelectorAll('[data-aws-row]');
      var lastRow = rows[rows.length - 1];
      rows.forEach(function (row, i) {
        if (i === rows.length - 1) return;
        made.push(ScrollTrigger.create({
          trigger: row,
          start: 'top 10%',
          endTrigger: lastRow,
          end: 'top 10%',
          pin: true,
          pinSpacing: false,
          invalidateOnRefresh: true
        }));
      });

      /* the sticker wobbles as the heading passes */
      var sticker = host.querySelector('[data-aws-sticker]');
      if (sticker) {
        made.push(gsap.fromTo(sticker, { rotation: -22, y: 20 }, {
          rotation: -10, y: -10, ease: 'none',
          scrollTrigger: { trigger: host.querySelector('[data-aws-title]'), start: 'top bottom', end: 'bottom top', scrub: 0.6 }
        }));
      }

      var resizeTimer;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () { layout(); ScrollTrigger.refresh(); }, 200);
      });
      ScrollTrigger.refresh();
    }

    load(CDN + 'gsap.min.js')
      .then(function () { return load(CDN + 'ScrollTrigger.min.js'); })
      .then(function () { return document.fonts && document.fonts.ready; })
      .then(build)
      .catch(function () { /* the still version stays on show */ });

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId && '{{ section.id }}'.indexOf(e.detail.sectionId) !== -1) {
        if (rafId) cancelAnimationFrame(rafId);
        timers.forEach(clearTimeout);
        made.forEach(function (a) { if (a.scrollTrigger) a.scrollTrigger.kill(); if (a.kill) a.kill(); });
      }
    });
  })();
</script>

