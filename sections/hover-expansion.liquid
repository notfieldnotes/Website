{% comment %}
  Hover expansion - the Skiper UI "hover expansion" (skiper35) as a section.

  A row of tall image panels. The panel under the cursor widens smoothly while
  the others narrow, and its title, text and link slide in. On phones the
  panels stack and a tap opens one. The first panel starts open.

  Panels come from the blocks; with no blocks it uses the products of the
  chosen collection (or the whole catalogue), linking to each product.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign sid = section.id | replace: '_', '-'
  assign source = s.collection.products | default: collections.all.products
-%}

<section class="hxp" id="hxp-{{ sid }}" data-hxp
  style="--hxp-bg:{{ s.background_color }};--hxp-ink:{{ s.text_color }};--hxp-h:{{ s.panel_height }}vh;--hxp-hm:{{ s.mobile_panel_height }}vh;--hxp-r:{{ s.radius }}px;--hxp-gap:{{ s.gap }}px;--hxp-grow:{{ s.expand }};--hxp-t:{{ s.speed }}ms;">

  {%- if s.heading != blank or s.text != blank -%}
    <div class="hxp__head">
      {%- if s.heading != blank -%}<h2 class="hxp__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="hxp__intro">{{ s.text | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="hxp__row" data-hxp-row>
    {%- if section.blocks.size > 0 -%}
      {%- for b in section.blocks -%}
        {%- assign i = b.settings -%}
        <a class="hxp__panel{% if forloop.first %} is-open{% endif %}" data-hxp-panel href="{{ i.link | default: '#' }}" {{ b.shopify_attributes }}>
          {%- if i.image != blank -%}
            {{ i.image | image_url: width: 1400 | image_tag: class: 'hxp__img', loading: 'lazy', widths: '500, 900, 1400', sizes: '(min-width: 750px) 60vw, 100vw', alt: i.title }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hxp__img hxp__img--ph' }}
          {%- endif -%}
          <span class="hxp__shade"></span>
          <span class="hxp__label">{{ i.title | escape }}</span>
          <span class="hxp__body">
            {%- if i.title != blank -%}<span class="hxp__title">{{ i.title | escape }}</span>{%- endif -%}
            {%- if i.caption != blank -%}<span class="hxp__text">{{ i.caption | escape }}</span>{%- endif -%}
            {%- if i.button_label != blank -%}<span class="hxp__btn">{{ i.button_label | escape }} &rarr;</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    {%- else -%}
      {%- for p in source limit: s.max_items -%}
        <a class="hxp__panel{% if forloop.first %} is-open{% endif %}" data-hxp-panel href="{{ p.url }}">
          {%- if p.featured_image != blank -%}
            {{ p.featured_image | image_url: width: 1400 | image_tag: class: 'hxp__img', loading: 'lazy', widths: '500, 900, 1400', sizes: '(min-width: 750px) 60vw, 100vw', alt: p.title }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hxp__img hxp__img--ph' }}
          {%- endif -%}
          <span class="hxp__shade"></span>
          <span class="hxp__label">{{ p.title | escape }}</span>
          <span class="hxp__body">
            <span class="hxp__title">{{ p.title | escape }}</span>
            <span class="hxp__text">{{ p.price | money }}</span>
            {%- if s.product_button != blank -%}<span class="hxp__btn">{{ s.product_button | escape }} &rarr;</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  #hxp-{{ sid }} { background: var(--hxp-bg); color: var(--hxp-ink); padding: {{ s.padding_top }}px 4vw {{ s.padding_bottom }}px; }
  #hxp-{{ sid }} * { box-sizing: border-box; }
  #hxp-{{ sid }} .hxp__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 3rem; margin-bottom: 2rem; }
  #hxp-{{ sid }} .hxp__heading {
    margin: 0; color: inherit; font-family: var(--heading-font-stack, sans-serif); font-weight: var(--heading-font-weight, 400);
    font-size: clamp(2rem, 5vw, 5rem); line-height: .95; text-transform: uppercase; letter-spacing: var(--heading-letterspacing, 0);
  }
  #hxp-{{ sid }} .hxp__intro { margin: 0; max-width: 28rem; font-family: var(--main-font-stack, sans-serif); font-size: 1rem; line-height: 1.5; opacity: .8; }

  #hxp-{{ sid }} .hxp__row { display: flex; flex-direction: column; gap: var(--hxp-gap); }
  #hxp-{{ sid }} .hxp__panel {
    position: relative; display: block; overflow: hidden; border-radius: var(--hxp-r);
    height: 4.5rem; color: #fff; text-decoration: none; background: #111;
    transition: height var(--hxp-t) cubic-bezier(.65,.05,.25,1), flex-grow var(--hxp-t) cubic-bezier(.65,.05,.25,1);
  }
  #hxp-{{ sid }} .hxp__panel.is-open { height: var(--hxp-hm); }
  #hxp-{{ sid }} .hxp__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); transition: transform calc(var(--hxp-t) * 1.6) cubic-bezier(.2,.7,.2,1); }
  #hxp-{{ sid }} .hxp__img--ph { background: #ddd; }
  #hxp-{{ sid }} .is-open .hxp__img { transform: scale(1); }
  #hxp-{{ sid }} .hxp__shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.65), rgba(0,0,0,.05) 55%); transition: opacity var(--hxp-t); }

  /* the closed label: a short line at the bottom, upright on desktop */
  #hxp-{{ sid }} .hxp__label {
    position: absolute; left: 1rem; bottom: 1.1rem; right: 1rem;
    font-family: var(--heading-font-stack, sans-serif); font-size: .95rem; text-transform: uppercase; letter-spacing: .02em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: opacity calc(var(--hxp-t) * .5);
  }
  #hxp-{{ sid }} .is-open .hxp__label { opacity: 0; }

  #hxp-{{ sid }} .hxp__body {
    position: absolute; left: 1.4rem; right: 1.4rem; bottom: 1.4rem; display: flex; flex-direction: column; align-items: flex-start; gap: .5rem;
    opacity: 0; transform: translateY(1rem); transition: opacity calc(var(--hxp-t) * .6), transform calc(var(--hxp-t) * .6);
  }
  #hxp-{{ sid }} .is-open .hxp__body { opacity: 1; transform: none; transition-delay: calc(var(--hxp-t) * .45); }
  #hxp-{{ sid }} .hxp__title { font-family: var(--heading-font-stack, sans-serif); font-size: clamp(1.4rem, 2.6vw, 2.6rem); line-height: 1; text-transform: uppercase; }
  #hxp-{{ sid }} .hxp__text { font-family: var(--main-font-stack, sans-serif); font-size: .95rem; line-height: 1.4; max-width: 30rem; opacity: .9; }
  #hxp-{{ sid }} .hxp__btn { margin-top: .4rem; padding: .55em 1.1em; border-radius: 999px; background: #fff; color: #111; font-family: var(--main-font-stack, sans-serif); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }

  @media (min-width: 750px) {
    #hxp-{{ sid }} .hxp__row { flex-direction: row; height: var(--hxp-h); }
    #hxp-{{ sid }} .hxp__panel { height: auto; flex: 1 1 0; min-width: 0; }
    #hxp-{{ sid }} .hxp__panel.is-open { height: auto; flex-grow: var(--hxp-grow); }
    /* closed panels show their name running up the side */
    #hxp-{{ sid }} .hxp__label {
      left: 50%; bottom: 1.4rem; right: auto; max-width: none; overflow: visible;
      transform: translateX(-50%) rotate(180deg); writing-mode: vertical-rl; white-space: nowrap;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #hxp-{{ sid }} .hxp__panel, #hxp-{{ sid }} .hxp__img, #hxp-{{ sid }} .hxp__body { transition: none; }
  }
</style>

<script>
  (function () {
    var host = document.getElementById('hxp-{{ sid }}');
    if (!host || host.dataset.hxpReady) return;
    host.dataset.hxpReady = '1';

    var panels = host.querySelectorAll('[data-hxp-panel]');
    var hoverable = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    function open(p) {
      panels.forEach(function (x) { x.classList.toggle('is-open', x === p); });
    }

    panels.forEach(function (p) {
      if (hoverable) {
        p.addEventListener('mouseenter', function () { open(p); });
        p.addEventListener('focus', function () { open(p); });
      } else {
        /* touch: the first tap opens a panel, the second follows its link */
        p.addEventListener('click', function (e) {
          if (!p.classList.contains('is-open')) { e.preventDefault(); open(p); }
        });
      }
    });

  })();
</script>

{% schema %}
{
  "name": "Hover expansion",
  "tag": "section",
  "class": "section-hover-expansion",
  "settings": [
    { "type": "paragraph", "content": "A row of image panels; the one under the cursor widens and shows its title and link (the Skiper UI hover expansion). Add panel blocks, or leave it empty to use products from a collection." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your pocket" },
    { "type": "text", "id": "text", "label": "Text", "default": "Every notebook has its own story. Hover to open one." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used when there are no panel blocks. Empty uses your whole catalogue." },
    { "type": "range", "id": "max_items", "label": "Products to show", "min": 3, "max": 8, "step": 1, "default": 5 },
    { "type": "text", "id": "product_button", "label": "Button on product panels", "default": "Shop now" },
    { "type": "header", "content": "Panels" },
    { "type": "range", "id": "panel_height", "label": "Height", "min": 40, "max": 90, "step": 5, "unit": "vh", "default": 70 },
    { "type": "range", "id": "mobile_panel_height", "label": "Open panel height on phones", "min": 30, "max": 80, "step": 5, "unit": "vh", "default": 55 },
    { "type": "range", "id": "expand", "label": "How wide the open panel gets", "min": 2, "max": 8, "step": 1, "default": 4, "info": "Times the width of a closed panel." },
    { "type": "range", "id": "speed", "label": "Speed", "min": 200, "max": 1200, "step": 50, "unit": "ms", "default": 600 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "header", "content": "Look" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3ece2" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#141414" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Panel title" },
        { "type": "text", "id": "caption", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Hover expansion" }
  ]
}
{% endschema %}
