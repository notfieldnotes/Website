{% comment %}
  Product view - the pinned flavour reel from henrietta.wearetattoodigital.com.

  The section pins while you scroll. Every product (a block) is one beat:

    1. its pack drops in from the top left, tilted, and settles upright
    2. it rests: the name tag and "view product" disc fade in over the wordmark
    3. the pack swings out to the bottom right while the huge wordmark slides
       across to the next word and the background colour cross-fades

  The wordmark is one continuous strip of every product's word. It stays still
  while a pack rests and only moves during the swap. One pack is on screen at a
  time. Built on GSAP ScrollTrigger over the real document scroll, so it runs
  under the smooth-scroll section without changing how the page scrolls.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign sid = section.id | replace: '_', '-'
  assign items = section.blocks
  assign total = items.size
  assign track = total | times: s.scroll_per_product
-%}

<section class="pvw" id="pvw-{{ sid }}"
  data-pvw
  style="--pvw-track:{{ track }}vh;--pvw-ink:{{ s.text_color }};--pvw-word:{{ s.wordmark_size }}vw;--pvw-wordm:{{ s.mobile_wordmark_size }}vw;--pvw-pack:{{ s.pack_height }}vh;--pvw-packm:{{ s.mobile_pack_height }}vh;--pvw-top:{{ s.top_offset }}px;">

  <div class="pvw__stage">
    {%- for b in items -%}
      {%- assign i = b.settings -%}
      <div class="pvw__bg{% if forloop.first %} is-first{% endif %}" data-pvw-bg style="background:{{ i.background_color }};" {{ b.shopify_attributes }}></div>
    {%- endfor -%}

    <div class="pvw__words" data-pvw-words aria-hidden="true">
      {%- for b in items -%}
        {%- assign i = b.settings -%}
        <span class="pvw__word{% if forloop.first %} is-first{% endif %}" data-pvw-word style="color:{{ i.word_color }};">{{ i.wordmark | default: i.name | escape }}</span>
      {%- endfor -%}
    </div>

    {%- for b in items -%}
      {%- assign i = b.settings -%}
      <div class="pvw__slide{% if forloop.first %} is-first{% endif %}" data-pvw-slide>
        {%- if i.image != blank -%}
          <img class="pvw__pack" data-pvw-pack
            src="{{ i.image | image_url: width: 1000 }}"
            srcset="{{ i.image | image_url: width: 600 }} 600w, {{ i.image | image_url: width: 1000 }} 1000w"
            sizes="40vw" width="{{ i.image.width }}" height="{{ i.image.height }}"
            alt="{{ i.image.alt | default: i.name | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {%- endif -%}

        {%- if i.name != blank -%}
          <span class="pvw__tag" data-pvw-fade style="color:{{ i.tag_text_color }};background:{{ i.tag_color }};">{{ i.name | escape }}</span>
        {%- endif -%}

        {%- if i.link != blank -%}
          <a class="pvw__disc" data-pvw-fade href="{{ i.link }}" style="color:{{ i.tag_color }};border-color:{{ i.tag_color }};">
            <span>{{ s.disc_text | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  #pvw-{{ sid }} { position: relative; height: 100vh; color: var(--pvw-ink); }
  #pvw-{{ sid }}[data-pvw-live] { height: calc(100vh + var(--pvw-track)); }
  #pvw-{{ sid }} * { box-sizing: border-box; }
  #pvw-{{ sid }} .pvw__stage { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  #pvw-{{ sid }} .pvw__bg { position: absolute; inset: 0; }

  /* the strip of words: one line, one word per product */
  #pvw-{{ sid }} .pvw__words {
    position: absolute; left: 50%; top: calc(50% + var(--pvw-top) / 2); z-index: 1;
    display: flex; align-items: center; gap: 8vw; white-space: nowrap;
    transform: translate(-50%, -50%); pointer-events: none; will-change: transform;
  }
  #pvw-{{ sid }}[data-pvw-live] .pvw__words { left: 0; transform: translate(0, -50%); }
  #pvw-{{ sid }} .pvw__word {
    flex: none; font-family: var(--font-heading-family, inherit); font-weight: 900;
    font-size: var(--pvw-wordm); line-height: .9; letter-spacing: -.02em; text-transform: uppercase;
  }

  #pvw-{{ sid }} .pvw__slide { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  #pvw-{{ sid }} .pvw__pack {
    position: absolute; left: 50%; top: calc(50% + var(--pvw-top) / 2);
    height: var(--pvw-packm); width: auto; max-width: none;
    transform: translate(-50%, -50%); will-change: transform;
    filter: drop-shadow(0 18px 24px rgba(0,0,0,.25));
  }
  #pvw-{{ sid }} .pvw__tag {
    position: absolute; left: 4vw; top: calc(50% + var(--pvw-top) / 2); opacity: 0;
    padding: .55em 1em; font-size: .7rem; letter-spacing: .1em; line-height: 1.5; text-transform: uppercase;
    transform: translateY(-50%); max-width: 30vw;
  }
  #pvw-{{ sid }} .pvw__disc {
    position: absolute; left: 62vw; top: calc(50% + var(--pvw-top) / 2 + 4vh); opacity: 0; pointer-events: auto;
    width: 4.5rem; height: 4.5rem; border: 1px solid; border-radius: 50%;
    display: grid; place-items: center; text-align: center; text-decoration: none;
    font-size: .55rem; letter-spacing: .08em; text-transform: uppercase; line-height: 1.2;
    transform: rotate(-12deg);
  }

  @media (min-width: 750px) {
    #pvw-{{ sid }} .pvw__word { font-size: var(--pvw-word); }
    #pvw-{{ sid }} .pvw__pack { height: var(--pvw-pack); }
    #pvw-{{ sid }} .pvw__tag { left: 7vw; font-size: .85rem; max-width: 18vw; }
    #pvw-{{ sid }} .pvw__disc { left: 57vw; width: 6.5rem; height: 6.5rem; font-size: .7rem; }
  }

  /* live: only the first background shows, and every slide waits its turn */
  #pvw-{{ sid }}[data-pvw-live] .pvw__slide { visibility: hidden; }

  /* before the script runs, or with reduced motion, show the first product */
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__bg:not(.is-first),
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__slide:not(.is-first),
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__word:not(.is-first) { display: none; }
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__slide.is-first [data-pvw-fade] { opacity: 1; }
</style>

<script>
  (function () {
    var host = document.getElementById('pvw-{{ sid }}');
    if (!host || host.dataset.pvwReady) return;
    host.dataset.pvwReady = '1';

    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var CDN = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/';

    function load(src) {
      return new Promise(function (ok, fail) {
        var el = document.querySelector('script[data-nfn-src="' + src + '"]');
        if (el) { if (el.dataset.done) ok(); else el.addEventListener('load', ok); return; }
        el = document.createElement('script');
        el.src = src; el.dataset.nfnSrc = src;
        el.onload = function () { el.dataset.done = '1'; ok(); };
        el.onerror = fail;
        document.head.appendChild(el);
      });
    }

    var tl, st;

    function build() {
      var gsap = window.gsap, ScrollTrigger = window.ScrollTrigger;
      gsap.registerPlugin(ScrollTrigger);

      var bgs = host.querySelectorAll('[data-pvw-bg]');
      var strip = host.querySelector('[data-pvw-words]');
      var words = host.querySelectorAll('[data-pvw-word]');
      var slides = host.querySelectorAll('[data-pvw-slide]');
      var n = slides.length;
      if (!n || !strip) return;

      host.setAttribute('data-pvw-live', '');

      var vw = function () { return window.innerWidth; };
      var vh = function () { return window.innerHeight; };

      /* where the strip must sit so that word i is centred on screen */
      var stop = function (i) {
        return function () {
          var w = words[i];
          return vw() / 2 - (w.offsetLeft + w.offsetWidth / 2);
        };
      };

      gsap.set(bgs, { opacity: 1 });
      for (var k = 1; k < bgs.length; k++) gsap.set(bgs[k], { opacity: 0 });

      tl = gsap.timeline({ defaults: { ease: 'none' } });
      tl.set(strip, { x: stop(0) }, 0);

      /* every product owns one unit of the timeline:
           i + .05 .. .35   pack drops in
           i + .35 .. .70   rests, tag and disc show
           i + .70 .. .95   pack swings out
           i + .70 .. 1.0   wordmark slides on, colour cross-fades
         the next pack only starts at i + 1.05, so two are never on screen */
      slides.forEach(function (slide, i) {
        var pack = slide.querySelector('[data-pvw-pack]');
        var fades = slide.querySelectorAll('[data-pvw-fade]');
        var t = i;

        tl.set(slide, { visibility: 'visible' }, t + 0.05);
        tl.set(slide, { visibility: 'hidden' }, t + 0.95);

        if (pack) {
          tl.fromTo(pack,
            { xPercent: -50, yPercent: -50,
              x: function () { return -vw() * 0.28; }, y: function () { return -vh() * 0.75; },
              rotation: 38, scale: 1.1 },
            { x: 0, y: 0, rotation: 0, scale: 1, duration: 0.3, ease: 'power3.out', immediateRender: false },
            t + 0.05);
          tl.to(pack,
            { x: function () { return vw() * 0.3; }, y: function () { return vh() * 0.8; },
              rotation: -42, scale: 1.1, duration: 0.25, ease: 'power2.in' },
            t + 0.7);
        }

        tl.fromTo(fades, { opacity: 0, y: 10 },
          { opacity: 1, y: 0, duration: 0.08, stagger: 0.04, immediateRender: false }, t + 0.36);
        tl.to(fades, { opacity: 0, duration: 0.06 }, t + 0.64);

        if (i < n - 1) {
          tl.fromTo(strip, { x: stop(i) }, { x: stop(i + 1), duration: 0.3, ease: 'power2.inOut', immediateRender: false }, t + 0.7);
          if (bgs[i + 1]) tl.to(bgs[i + 1], { opacity: 1, duration: 0.3, ease: 'power1.inOut' }, t + 0.7);
        }
      });

      st = ScrollTrigger.create({
        trigger: host,
        start: 'top top',
        end: 'bottom bottom',
        animation: tl,
        scrub: 0.5,
        invalidateOnRefresh: true
      });
      ScrollTrigger.refresh();
    }

    load(CDN + 'gsap.min.js')
      .then(function () { return load(CDN + 'ScrollTrigger.min.js'); })
      .then(function () { return document.fonts && document.fonts.ready; })
      .then(build)
      .catch(function () { /* the first product stays on show */ });

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId && '{{ section.id }}'.indexOf(e.detail.sectionId) !== -1) {
        if (st) st.kill();
        if (tl) tl.kill();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product view",
  "tag": "section",
  "class": "section-product-view",
  "settings": [
    { "type": "paragraph", "content": "A pinned reel, after the Henrietta Said site. Each product is a block: its pack drops in, rests with a name tag and disc, then swings out while the huge wordmark slides to the next word and the colour cross-fades. Runs on the normal page scroll, so it works under Smooth scroll." },
    { "type": "range", "id": "scroll_per_product", "label": "Scroll per product", "min": 80, "max": 300, "step": 10, "unit": "vh", "default": 150 },
    { "type": "text", "id": "disc_text", "label": "Disc text", "default": "View product" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "range", "id": "top_offset", "label": "Space for the header", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "header", "content": "Wordmark and pack" },
    { "type": "range", "id": "wordmark_size", "label": "Wordmark size", "min": 12, "max": 50, "step": 1, "unit": "vw", "default": 26 },
    { "type": "range", "id": "pack_height", "label": "Pack height", "min": 30, "max": 90, "step": 2, "unit": "vh", "default": 52 },
    { "type": "header", "content": "On phones" },
    { "type": "range", "id": "mobile_wordmark_size", "label": "Wordmark size", "min": 20, "max": 70, "step": 2, "unit": "vw", "default": 44 },
    { "type": "range", "id": "mobile_pack_height", "label": "Pack height", "min": 20, "max": 70, "step": 2, "unit": "vh", "default": 40 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Original flavour", "info": "Shown on the small tag." },
        { "type": "text", "id": "wordmark", "label": "Wordmark", "info": "The huge word behind the pack. Leave empty to use the name." },
        { "type": "image_picker", "id": "image", "label": "Pack image", "info": "A cut-out PNG or WebP with a transparent background." },
        { "type": "url", "id": "link", "label": "Product link" },
        { "type": "header", "content": "Colours" },
        { "type": "color", "id": "background_color", "label": "Background", "default": "#c8201f" },
        { "type": "color", "id": "word_color", "label": "Wordmark", "default": "#e8a595" },
        { "type": "color", "id": "tag_color", "label": "Tag", "default": "#7d1a14" },
        { "type": "color", "id": "tag_text_color", "label": "Tag text", "default": "#ffffff" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product view",
      "blocks": [
        { "type": "product", "settings": { "name": "Nashville hot chicken", "wordmark": "Chimichurri", "background_color": "#c8201f", "word_color": "#e8a595" } },
        { "type": "product", "settings": { "name": "Original buffalo", "wordmark": "Buffalo", "background_color": "#f0431a", "word_color": "#e8a595" } },
        { "type": "product", "settings": { "name": "Honey mustard", "wordmark": "Mustard", "background_color": "#ee9114", "word_color": "#e8a595" } }
      ]
    }
  ]
}
{% endschema %}
