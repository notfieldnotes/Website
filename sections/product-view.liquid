{% comment %}
  Product view - the pinned flavour reel from henrietta.wearetattoodigital.com.

  The section pins while you scroll. Each product (a block) gets its own colour
  that wipes up over the last one, a huge wordmark that slides across behind it,
  and the pack that swings in tilted, settles upright with its tag and
  "view product" disc, then swings out as the next product arrives.

  Built on GSAP ScrollTrigger, reading the real document scroll, so it runs
  under the smooth-scroll section without changing how the page scrolls.
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign sid = section.id | replace: '_', '-'
  assign items = section.blocks
  assign total = items.size
  assign track = total | times: s.scroll_per_product
-%}

<section class="pvw" id="pvw-{{ sid }}"
  data-pvw
  data-count="{{ total }}"
  style="--pvw-track:{{ track }}vh;--pvw-ink:{{ s.text_color }};--pvw-word:{{ s.wordmark_size }}vw;--pvw-wordm:{{ s.mobile_wordmark_size }}vw;--pvw-pack:{{ s.pack_height }}vh;--pvw-packm:{{ s.mobile_pack_height }}vh;--pvw-top:{{ s.top_offset }}px;">

  <div class="pvw__stage">
    {%- for b in items -%}
      {%- assign i = b.settings -%}
      <div class="pvw__bg{% if forloop.first %} is-first{% endif %}" data-pvw-bg style="background:{{ i.background_color }};" {{ b.shopify_attributes }}></div>
    {%- endfor -%}

    {%- for b in items -%}
      {%- assign i = b.settings -%}
      <div class="pvw__word{% if forloop.first %} is-first{% endif %}" data-pvw-word aria-hidden="true" style="color:{{ i.word_color }};">{{ i.wordmark | default: i.name | escape }}</div>
    {%- endfor -%}

    {%- for b in items -%}
      {%- assign i = b.settings -%}
      <div class="pvw__slide{% if forloop.first %} is-first{% endif %}" data-pvw-slide>
        {%- if i.image != blank -%}
          <img class="pvw__pack" data-pvw-pack
            src="{{ i.image | image_url: width: 1000 }}"
            srcset="{{ i.image | image_url: width: 600 }} 600w, {{ i.image | image_url: width: 1000 }} 1000w"
            sizes="40vw" width="{{ i.image.width }}" height="{{ i.image.height }}"
            alt="{{ i.image.alt | default: i.name | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {%- endif -%}

        {%- if i.name != blank -%}
          <span class="pvw__tag" data-pvw-fade style="color:{{ i.tag_text_color }};background:{{ i.tag_color }};">{{ i.name | escape }}</span>
        {%- endif -%}

        {%- if i.link != blank -%}
          <a class="pvw__disc" data-pvw-fade href="{{ i.link }}" style="color:{{ i.tag_text_color }};border-color:{{ i.tag_text_color }};">
            <span>{{ s.disc_text | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  #pvw-{{ sid }} { position: relative; height: calc(100vh + var(--pvw-track)); color: var(--pvw-ink); }
  #pvw-{{ sid }} * { box-sizing: border-box; }
  #pvw-{{ sid }} .pvw__stage {
    position: sticky; top: 0; height: 100vh; overflow: hidden;
    padding-top: var(--pvw-top);
  }
  #pvw-{{ sid }} .pvw__bg { position: absolute; inset: 0; will-change: clip-path; }
  #pvw-{{ sid }} .pvw__word {
    position: absolute; left: 0; top: calc(50% + var(--pvw-top) / 2); z-index: 1;
    transform: translate(100vw, -50%);
    font-family: var(--font-heading-family, inherit); font-weight: 900;
    font-size: var(--pvw-wordm); line-height: .9; letter-spacing: -.02em;
    text-transform: uppercase; white-space: nowrap; pointer-events: none;
    opacity: 0; will-change: transform;
  }
  #pvw-{{ sid }} .pvw__slide { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  #pvw-{{ sid }}[data-pvw-live] .pvw__slide { visibility: hidden; }
  #pvw-{{ sid }}[data-pvw-live] .pvw__pack { opacity: 1; }
  #pvw-{{ sid }} .pvw__pack {
    position: absolute; left: 50%; top: calc(50% + var(--pvw-top) / 2);
    height: var(--pvw-packm); width: auto; max-width: none;
    transform: translate(-50%, -50%); opacity: 0; will-change: transform;
    filter: drop-shadow(0 18px 24px rgba(0,0,0,.25));
  }
  #pvw-{{ sid }} .pvw__tag {
    position: absolute; left: 6vw; top: 50%; opacity: 0;
    padding: .55em 1em; font-size: .8rem; letter-spacing: .08em; text-transform: uppercase;
    transform: translateY(-50%) rotate(-3deg);
  }
  #pvw-{{ sid }} .pvw__disc {
    position: absolute; right: 22vw; top: 56%; opacity: 0; pointer-events: auto;
    width: 5.5rem; height: 5.5rem; border: 1px solid; border-radius: 50%;
    display: grid; place-items: center; text-align: center; text-decoration: none;
    font-size: .65rem; letter-spacing: .08em; text-transform: uppercase; line-height: 1.2;
    transform: rotate(-12deg);
  }

  @media (min-width: 750px) {
    #pvw-{{ sid }} .pvw__word { font-size: var(--pvw-word); }
    #pvw-{{ sid }} .pvw__pack { height: var(--pvw-pack); }
    #pvw-{{ sid }} .pvw__tag { left: 12vw; }
    #pvw-{{ sid }} .pvw__disc { right: 30vw; width: 7rem; height: 7rem; font-size: .75rem; }
  }

  /* before the script runs, or with reduced motion, show the first product */
  #pvw-{{ sid }}:not([data-pvw-live]) { height: 100vh; }
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__bg:not(.is-first) { display: none; }
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__slide:not(.is-first) { display: none; }
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__word:not(.is-first) { display: none; }
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__word.is-first { transform: translate(-50%, -50%); left: 50%; opacity: 1; }
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__slide.is-first .pvw__pack,
  #pvw-{{ sid }}:not([data-pvw-live]) .pvw__slide.is-first [data-pvw-fade] { opacity: 1; }
</style>

<script>
  (function () {
    var host = document.getElementById('pvw-{{ sid }}');
    if (!host || host.dataset.pvwReady) return;
    host.dataset.pvwReady = '1';

    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var CDN = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/';
    /* enter 0.35 + rest + exit 0.3 must finish inside the product's own unit, so two packs are never on screen together */
    var HOLD = Math.min(0.25, {{ s.hold }} / 100);

    function load(src) {
      return new Promise(function (ok, fail) {
        var el = document.querySelector('script[data-nfn-src="' + src + '"]');
        if (el) { if (el.dataset.done) ok(); else el.addEventListener('load', ok); return; }
        el = document.createElement('script');
        el.src = src; el.dataset.nfnSrc = src;
        el.onload = function () { el.dataset.done = '1'; ok(); };
        el.onerror = fail;
        document.head.appendChild(el);
      });
    }

    var tl, st;

    function build() {
      var gsap = window.gsap, ScrollTrigger = window.ScrollTrigger;
      gsap.registerPlugin(ScrollTrigger);

      var bgs = host.querySelectorAll('[data-pvw-bg]');
      var words = host.querySelectorAll('[data-pvw-word]');
      var slides = host.querySelectorAll('[data-pvw-slide]');
      var n = bgs.length;
      if (!n) return;

      host.setAttribute('data-pvw-live', '');
      var vw = function () { return window.innerWidth; };

      gsap.set(bgs, { clipPath: 'inset(100% 0% 0% 0%)' });
      gsap.set(bgs[0], { clipPath: 'inset(0% 0% 0% 0%)' });

      tl = gsap.timeline({ defaults: { ease: 'none' } });

      slides.forEach(function (slide, i) {
        var pack = slide.querySelector('[data-pvw-pack]');
        var fades = slide.querySelectorAll('[data-pvw-fade]');
        var word = words[i];
        var t = i; /* each product owns one unit of the timeline */

        /* only this product's slide is visible during its own window */
        tl.set(slide, { visibility: 'visible' }, t);
        tl.set(slide, { visibility: 'hidden' }, t + 0.35 + HOLD + 0.3);

        /* colour wipes up over the previous product */
        if (i > 0) tl.to(bgs[i], { clipPath: 'inset(0% 0% 0% 0%)', duration: 0.25, ease: 'power2.inOut' }, t - 0.2);

        /* the wordmark crosses the whole screen, start to finish */
        tl.fromTo(word,
          { x: function () { return vw() * 0.9; }, opacity: 1 },
          { x: function () { return -(word.offsetWidth) + vw() * 0.1; }, duration: 1, immediateRender: false }, Math.max(0, t - 0.15));
        tl.set(word, { opacity: 0 }, t + 0.85);

        if (pack) {
          /* swing in, tilted, from the top left, and settle upright */
          tl.fromTo(pack,
            { xPercent: -50, yPercent: -50, x: function () { return -vw() * 0.35; }, y: function () { return -window.innerHeight * 0.9; }, rotation: -38, scale: 1.25 },
            { x: 0, y: 0, rotation: 0, scale: 1, duration: 0.35, ease: 'power3.out', immediateRender: false }, t);
          /* hold, then swing out to the right */
          tl.to(pack,
            { x: function () { return vw() * 0.4; }, y: function () { return window.innerHeight * 0.9; }, rotation: 28, scale: 1.15, duration: 0.3, ease: 'power2.in' },
            t + 0.35 + HOLD);
        }

        tl.fromTo(fades, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.1, stagger: 0.04, immediateRender: false }, t + 0.35);
        tl.to(fades, { opacity: 0, duration: 0.08 }, t + 0.35 + HOLD - 0.05);
      });

      /* pad the end so the last product can leave */
      tl.to({}, { duration: 0.05 });

      st = ScrollTrigger.create({
        trigger: host,
        start: 'top top',
        end: 'bottom bottom',
        animation: tl,
        scrub: 0.6,
        invalidateOnRefresh: true
      });
      ScrollTrigger.refresh();
    }

    load(CDN + 'gsap.min.js')
      .then(function () { return load(CDN + 'ScrollTrigger.min.js'); })
      .then(build)
      .catch(function () { /* the first product stays on show */ });

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail && e.detail.sectionId && '{{ section.id }}'.indexOf(e.detail.sectionId) !== -1) {
        if (st) st.kill();
        if (tl) tl.kill();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product view",
  "tag": "section",
  "class": "section-product-view",
  "settings": [
    { "type": "paragraph", "content": "A pinned reel. Each product is a block: its colour wipes up, its name slides across as a huge wordmark, and the pack swings in and out. Runs on the normal page scroll, so it works under Smooth scroll." },
    { "type": "range", "id": "scroll_per_product", "label": "Scroll per product", "min": 60, "max": 300, "step": 10, "unit": "vh", "default": 140 },
    { "type": "range", "id": "hold", "label": "How long the pack rests", "min": 0, "max": 25, "step": 5, "unit": "%", "default": 25, "info": "Time the pack stays upright before it leaves. Capped so packs never overlap." },
    { "type": "text", "id": "disc_text", "label": "Disc text", "default": "View product" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "range", "id": "top_offset", "label": "Space for the header", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Wordmark and pack" },
    { "type": "range", "id": "wordmark_size", "label": "Wordmark size", "min": 12, "max": 50, "step": 1, "unit": "vw", "default": 30 },
    { "type": "range", "id": "pack_height", "label": "Pack height", "min": 30, "max": 90, "step": 2, "unit": "vh", "default": 62 },
    { "type": "header", "content": "On phones" },
    { "type": "range", "id": "mobile_wordmark_size", "label": "Wordmark size", "min": 20, "max": 70, "step": 2, "unit": "vw", "default": 44 },
    { "type": "range", "id": "mobile_pack_height", "label": "Pack height", "min": 20, "max": 70, "step": 2, "unit": "vh", "default": 42 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Original flavour", "info": "Shown on the small tag." },
        { "type": "text", "id": "wordmark", "label": "Wordmark", "info": "The huge word behind the pack. Leave empty to use the name." },
        { "type": "image_picker", "id": "image", "label": "Pack image", "info": "A cut-out PNG or WebP with a transparent background." },
        { "type": "url", "id": "link", "label": "Product link" },
        { "type": "header", "content": "Colours" },
        { "type": "color", "id": "background_color", "label": "Background", "default": "#a51d1d" },
        { "type": "color", "id": "word_color", "label": "Wordmark", "default": "#e8a595" },
        { "type": "color", "id": "tag_color", "label": "Tag", "default": "#ffffff" },
        { "type": "color", "id": "tag_text_color", "label": "Tag text", "default": "#111111" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product view",
      "blocks": [
        { "type": "product", "settings": { "name": "Nashville hot chicken", "wordmark": "Chimichurri", "background_color": "#a51d1d", "word_color": "#e8a595" } },
        { "type": "product", "settings": { "name": "Original buffalo", "wordmark": "Buffalo", "background_color": "#f0431a", "word_color": "#e8a595" } },
        { "type": "product", "settings": { "name": "Honey mustard", "wordmark": "Mustard", "background_color": "#ee9114", "word_color": "#e8a595" } }
      ]
    }
  ]
}
{% endschema %}
